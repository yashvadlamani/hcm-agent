# Which model backend Clara uses: anthropic (default) or azure_openai
LLM_PROVIDER=anthropic

# Claude API (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the model (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Azure OpenAI / Azure AI Foundry (when LLM_PROVIDER=azure_openai)
# Endpoint is the v1 URL: https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The deployment name you chose in Foundry, not the model name
AZURE_OPENAI_DEPLOYMENT=
# minimal (default) suits gpt-5 family models; leave empty for non-reasoning models like gpt-4o
# AZURE_OPENAI_REASONING_EFFORT=minimal

# Azure Communication Services (ACS): places the calls, speaks and listens
# Connection string: ACS resource -> Settings -> Keys (a secret: stored in Key Vault on deploy)
ACS_CONNECTION_STRING=endpoint=https://<acs-resource>.unitedstates.communication.azure.com/;accesskey=<key>
# Clara's number: a trial or purchased ACS number. Trial numbers can only call verified numbers.
ACS_PHONE_NUMBER=+1XXXXXXXXXX
# The Azure AI Services resource ACS uses for text-to-speech and speech recognition (its
# custom-domain endpoint). The ACS resource's managed identity needs "Cognitive Services User" on it.
ACS_COGNITIVE_SERVICES_ENDPOINT=https://<ai-resource>.cognitiveservices.azure.com
# Optional: Clara's voice (any Azure neural voice; default en-US-JennyNeural)
# ACS_VOICE=en-US-JennyNeural

# Server-owned member records for name/DOB verification; defaults to data/demo_members.json.
# MEMBER_DATA_PATH=/absolute/path/to/members.json

# Local persistent Chroma index for the diabetes playbook (directory must be writable).
# CLARA_PLAYBOOK_VECTOR_DIR=/path/to/writable/diabetes-playbook-index

# Policy PDF RAG uses data/policies/sbc-gpsd69bceiilo-il-2025.pdf by default.
# CLARA_POLICY_VECTOR_DIR=/path/to/writable/plan-policy-index

# Provider directory snapshot (must be authoritative and source_status=active to return results).
# CLARA_PROVIDER_DIRECTORY_PATH=/path/to/provider_directory.json

# Secret path segment in the call-event callback URL that ACS posts to (generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))")
PHONE_WEBHOOK_KEY=replace_with_random_value

# Password for the live call view (/live). Leave empty locally to keep /live local-only;
# required when the app runs on a public host such as Azure.
LIVE_VIEW_PASSWORD=

# Outbound calls (clara-call and the call-request Azure Function)
# The Clara server's public address; clara-call uses it when --url isn't given.
CLARA_BASE_URL=https://<your-app>.azurewebsites.net
# Numbers that may be called, comma-separated. Required for the Azure Function, which
# refuses every call without it; optional for clara-call.
ALLOWED_CALL_NUMBERS=+1XXXXXXXXXX
# Most calls the Azure Function places per hour (default 10)
MAX_CALLS_PER_HOUR=10

# Emergency escalations (urgent alerts, clinical review tasks, safety follow-ups). They are always
# kept in memory and written to the server log. Set a file to keep them across restarts (on Azure
# App Service, a path under /home persists), and a webhook to post each urgent alert to a channel.
# ESCALATION_LOG_PATH=/home/clara/escalations.jsonl
# ESCALATION_WEBHOOK_URL=https://<your-teams-or-slack-incoming-webhook>

# Security audit log: every tool call (name, allowed or denied, member ID; never arguments) and
# every policy decision. Always kept in memory; set a file to keep it across restarts.
# AUDIT_LOG_PATH=/home/clara/audit.jsonl
# Most tool calls one call may make per minute (emergency and identity tools are never limited).
# TOOL_CALLS_PER_MINUTE=120

# Port for the Clara phone server
FLASK_PORT=5000
